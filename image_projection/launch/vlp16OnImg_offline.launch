<launch>
    <arg name="image_topic"         default="/terrasentia/front_mono/image_rect_gray/compressed" />
    <arg name="pointcloud_topic"    default="/terrasentia/velodyne_points" />

    <param name="imgTopic"  type="str"  value="$(arg image_topic)" />
    <param name="pcTopic"   type="str"  value="$(arg pointcloud_topic)" />

    <param name="maxlen"        type="double" value="200.0" />    
    <param name="minlen"        type="double" value="0.0" />    
    <param name="max_ang_FOV"   type="double" value="2.7" />
    <param name="min_ang_FOV"   type="double" value="0.5" />
    
    <!-- <param name="imgTopic"      type="str"    value="/terrasentia/traversability_map/compressed" /> -->

    <param name="y_interpolation" type="double" value="2.0" />
    <param name="x_resolution"    type="double" value="0.25" />
    <param name="ang_Y_resolution"    type="double" value="2.05" /> 
    <param name="ang_ground"    type="double" value="0.0" />
    <param name="max_var"    type="double" value="100.0" />
    <param name="filter_output_pc"    type="bool" value="false" />

    <group ns="matrix_file">
        <!-- <rosparam file="$(find image_projection)/cfg/cfg_params.yaml" /> -->
        <rosparam file="$(find image_projection)/cfg/wayfast_params.yaml" />
    </group>
    
    <node pkg="image_projection" type="projection_node" name="projection_node" output="screen"/>

    <!-- rviz- -->
    <node type="rviz" name="rviz" pkg="rviz" args="-d $(find image_projection)/rviz/lidar_camera.rviz" />
</launch>
