<launch>
    <arg name="image_topic"         default="/zest/traversability_image" />
    <arg name="pointcloud_topic"    default="/lidar/points" />
    <arg name="params_file"         default="$(find image_projection)/cfg/llm_params.yaml" />
    
    <node pkg="image_projection" type="projection_node" name="projection_node" output="screen">
        <param name="image_topic"       type="str"      value="$(arg image_topic)" />
        <param name="pointcloud_topic"  type="str"      value="$(arg pointcloud_topic)" />
        <param name="maxlen"            type="double"   value="200.0" />    
        <param name="minlen"            type="double"   value="0.0" />    
        <param name="max_ang_FOV"       type="double"   value="2.7" />
        <param name="min_ang_FOV"       type="double"   value="0.5" />
        <param name="y_interpolation"   type="double"   value="2.0" />
        <param name="angular_resolution_x"  type="double"   value="0.25" />
        <param name="angular_resolution_y"  type="double"   value="2.05" />
        <param name="max_var"           type="double"   value="100.0" />
        <param name="filter_output_pc"  type="bool"     value="false" />

        <!-- Load camera intrinsics; extrinsics come from TF -->
        <rosparam file="$(arg params_file)" />
    </node>
</launch>
