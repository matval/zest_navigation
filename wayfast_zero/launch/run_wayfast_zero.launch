<!-- load_params.launch -->
<launch>
    <!-- Use python virtualenv -->
    <arg name="venv" value="$(find wayfast_zero)/../env/bin/python3" />

    <!-- Load the YAML file as ROS parameters -->
    <rosparam file="$(find wayfast_zero)/config/config.yaml" command="load" />

    <!-- Start the prediction node -->
    <!-- <node pkg="wayfast_zero" type="wayfast_zero.py" name="wayfast_zero" output="screen" launch-prefix = "$(arg venv)" /> -->

    <!-- Start the mock prediction node -->
    <node pkg="octomap_utils" type="image_transform.py" name="trav_images" output="log"/>

    <!-- Start the camera to lidar projection node -->
    <include file="$(find lidar_camera_fusion)/launch/vlp16OnImg_offline.launch" />

    <!-- Start the traversability octomap node -->
    <!-- <node pkg="traversability_bki" type="octomap_node" name="octomap_node" output="screen">
        <rosparam file="$(find traversability_bki)/config/traversability_bki.yaml" command="load" />
    </node> -->

    <!--Start the LA3DM node -->
    <node pkg="la3dm" type="bgkloctomap_server" name="la3dm_server" output="screen">
        <rosparam file="$(find la3dm)/config/bgkloctomap_large_map.yaml" command="load"/>
    </node>
</launch>