<launch>
    <arg name="namespace"          default="zest"/>
    <arg name="image_topic"        default="/camera/rgb/image_rect_color/compressed"/>
    <arg name="pointcloud_topic"   default="/lidar/points"/>
    <arg name="odom_topic"         default="/odom"/>
    <arg name="cmd_topic"          default="/cmd_vel"/>
    <arg name="goal_topic"         default="/move_base_simple/goal"/>
    <arg name="joy_topic"          default="/joy"/>
    <arg name="enable_mode"        default="joystick" doc="MPPI enable source: joystick or service"/>
    <arg name="camera_params_file" default="$(find image_projection)/cfg/llm_params.yaml"/>
    <arg name="rviz_config"        default="$(find image_projection)/rviz/lidar_camera.rviz"/>

    <!-- Bag replay: simulated time and RViz are always on -->
    <include file="$(find llm_prediction)/launch/run_zest.launch">
        <arg name="namespace"          value="$(arg namespace)"/>
        <arg name="image_topic"        value="$(arg image_topic)"/>
        <arg name="pointcloud_topic"   value="$(arg pointcloud_topic)"/>
        <arg name="odom_topic"         value="$(arg odom_topic)"/>
        <arg name="cmd_topic"          value="$(arg cmd_topic)"/>
        <arg name="goal_topic"         value="$(arg goal_topic)"/>
        <arg name="joy_topic"          value="$(arg joy_topic)"/>
        <arg name="enable_mode"        value="$(arg enable_mode)"/>
        <arg name="camera_params_file" value="$(arg camera_params_file)"/>
        <arg name="rviz_config"        value="$(arg rviz_config)"/>
        <arg name="use_sim_time"       value="true"/>
        <arg name="rviz"               value="true"/>
    </include>
</launch>
